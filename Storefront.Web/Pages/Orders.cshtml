@page
@model Storefront.Web.Pages.OrdersModel
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title mb-0">Orders</h1>
    <a asp-page="/Orders" class="btn btn-outline-secondary btn-sm">Refresh</a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger">
        <strong>Can't reach the Order Service.</strong>
        Make sure <code>OrderService.Api</code> is running on <code>https://localhost:7054</code>.
        <div class="small text-muted mt-1">@Model.Error</div>
    </div>
}
else if (!Model.Orders.Any())
{
    <div class="empty-state">
        <div class="empty-icon">🧾</div>
        <h5>No orders yet</h5>
        <a asp-page="/Index" class="btn btn-primary mt-2">Start shopping</a>
    </div>
}
else
{
    <div class="panel p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 orders-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Placed</th>
                        <th class="text-center">Items</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td><a asp-page="/OrderStatus" asp-route-id="@order.OrderId" class="font-monospace">#@order.OrderId.ToString()[..8]</a></td>
                            <td>@order.CustomerName</td>
                            <td class="text-muted small">@order.CreatedAt.ToLocalTime().ToString("MMM d, h:mm tt")</td>
                            <td class="text-center">@order.Items.Sum(i => i.Quantity)</td>
                            <td class="text-end">₱@order.TotalAmount.ToString("N2")</td>
                            <td class="text-end"><span class="status-pill status-@order.Status.ToLowerInvariant()">@order.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
