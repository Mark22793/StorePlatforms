@page
@model OrdersModel
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Customer Orders</h1>
        <p class="text-muted small mb-0">Track live orders processed through the Order → Inventory → Payment saga.</p>
    </div>
    <a asp-page="Orders" class="btn btn-outline-secondary btn-sm rounded-2 fw-semibold">
        <i class="bi bi-arrow-clockwise me-1"></i>Refresh
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger shadow-sm rounded-3 mb-4">
        <strong>Can't reach the Order Service.</strong>
        <div class="small text-muted mt-1">@Model.Error</div>
    </div>
}
else
{
    <div class="table-container">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Placed Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <div class="fs-2 mb-2">📋</div>
                            <div class="fw-semibold">No orders placed yet</div>
                            <div class="small">When customers check out, their orders will appear here.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model.Orders)
                    {
                        var statusClass = order.Status?.ToLower() switch
                        {
                            "confirmed" => "confirmed",
                            "cancelled" => "cancelled",
                            _ => "pending"
                        };

                        var totalItemsCount = order.Items?.Sum(i => i.Quantity) ?? 0;

                        <tr>
                            <td class="fw-bold text-primary">#@order.OrderId.ToString()[..8]</td>
                            <td class="fw-semibold">@(string.IsNullOrWhiteSpace(order.CustomerName) ? "Anonymous" : order.CustomerName)</td>
                            <td class="text-muted">@order.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • h:mm tt")</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @totalItemsCount @(totalItemsCount == 1 ? "item" : "items")
                                </span>
                            </td>
                            <td class="fw-bold">₱@order.TotalAmount.ToString("N2")</td>
                            <td>
                                <span class="badge-status @statusClass">
                                    @order.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}