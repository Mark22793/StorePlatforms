@page
@model Storefront.Web.Pages.CartModel
@{
    ViewData["Title"] = "Cart";
}

<h1 class="page-title">Your cart</h1>

<partial name="_StatusMessage" model="Model.StatusMessage" />

@if (!ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All"></div>
}

@if (!Model.CartItems.Any())
{
    <div class="empty-state">
        <div class="empty-icon">🛒</div>
        <h5>Your cart is empty</h5>
        <p class="text-muted">Browse the catalog and add something.</p>
        <a asp-page="/Index" class="btn btn-primary">Continue shopping</a>
    </div>
}
else
{
    <div class="cart-layout">
        <div class="panel">
            <div class="table-responsive">
            <table class="table align-middle mb-0 cart-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Price</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CartItems)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.Name</div>
                                <div class="small text-muted font-monospace">@item.ProductId.ToString()[..8]</div>
                            </td>
                            <td class="text-end">₱@item.UnitPrice.ToString("N2")</td>
                            <td class="text-center">
                                <form method="post" asp-page-handler="Update" class="d-inline-flex gap-1">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="0" class="form-control form-control-sm qty-input" aria-label="Quantity for @item.Name" onchange="this.form.submit()" />
                                </form>
                            </td>
                            <td class="text-end fw-semibold">₱@item.Subtotal.ToString("N2")</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Remove">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-link text-danger" aria-label="Remove @item.Name">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <div class="d-flex justify-content-between mt-3">
                <a asp-page="/Index" class="btn btn-outline-secondary btn-sm">← Continue shopping</a>
                <form method="post" asp-page-handler="Clear">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Clear cart</button>
                </form>
            </div>
        </div>

        <aside class="panel summary">
            <h2 class="h5 mb-3">Order summary</h2>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Items</span>
                <span>@Model.CartItems.Sum(i => i.Quantity)</span>
            </div>
            <div class="d-flex justify-content-between summary-total">
                <span>Total</span>
                <span>₱@Model.Total.ToString("N2")</span>
            </div>
            <p class="small text-muted mt-2">Final prices are confirmed by the Catalog Service when the order is placed.</p>

            <form method="post" asp-page-handler="Checkout" class="mt-3">
                <label asp-for="CustomerName" class="form-label fw-semibold">Customer name</label>
                <input asp-for="CustomerName" class="form-control mb-3" placeholder="e.g. Juan Dela Cruz" required />
                <button type="submit" class="btn btn-success w-100 btn-lg">Place order</button>
            </form>
        </aside>
    </div>
}
