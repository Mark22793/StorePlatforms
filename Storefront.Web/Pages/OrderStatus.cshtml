@page "{id:guid}"
@model Storefront.Web.Pages.OrderStatusModel
@{
    ViewData["Title"] = "Order Status";
    var status = Model.Order?.Status ?? "";
    var isConfirmed = status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase);
    var isCancelled = status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
}

@section Head {
    @if (Model.IsPending)
    {
        @* Saga is still running: refresh until the order is Confirmed or Cancelled *@
        <meta http-equiv="refresh" content="3" />
    }
}

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Order == null)
{
    <div class="empty-state">
        <div class="empty-icon">🔍</div>
        <h5>Order not found</h5>
        <p class="text-muted">We couldn't find that order in the Order Service.</p>
        <a asp-page="/Orders" class="btn btn-primary">View all orders</a>
    </div>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h1 class="page-title mb-1">Order <span class="font-monospace">#@Model.Order.OrderId.ToString()[..8]</span></h1>
            <div class="text-muted small">Placed @Model.Order.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt") by @Model.Order.CustomerName</div>
        </div>
        <span class="status-pill status-@status.ToLowerInvariant()">@status</span>
    </div>

    <div class="panel mb-3">
        <ol class="saga-steps">
            <li class="done"><span class="dot"></span>Order placed</li>
            <li class="@(isConfirmed ? "done" : isCancelled ? "failed" : "active")"><span class="dot"></span>Inventory &amp; payment</li>
            <li class="@(isConfirmed ? "done" : isCancelled ? "failed" : "")"><span class="dot"></span>@(isCancelled ? "Cancelled" : "Confirmed")</li>
        </ol>
        @if (Model.IsPending)
        {
            <p class="small text-muted mb-0 mt-2" role="status" aria-live="polite">
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                Waiting for Inventory and Payment services… this page refreshes automatically.
            </p>
        }
        else if (isCancelled)
        {
            <p class="small text-danger mb-0 mt-2">The order was cancelled. Stock was unavailable or the payment failed.</p>
        }
    </div>

    <div class="panel">
        <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Unit price</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Order.Items)
                {
                    <tr>
                        <td class="fw-semibold">@Model.NameFor(item.ProductId)</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">₱@item.UnitPrice.ToString("N2")</td>
                        <td class="text-end">₱@item.Subtotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th class="text-end">₱@Model.Order.TotalAmount.ToString("N2")</th>
                </tr>
            </tfoot>
        </table>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <a asp-page="/Index" class="btn btn-primary">Continue shopping</a>
        <a asp-page="/Orders" class="btn btn-outline-secondary">All orders</a>
    </div>
}
