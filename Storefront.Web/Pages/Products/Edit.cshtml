@page "{id:guid}"
@model Storefront.Web.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <!-- Back Button -->
        <a asp-page="Index" class="btn btn-link text-decoration-none text-muted p-0 mb-3 d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <!-- Header Banner -->
            <div class="bg-dark bg-gradient text-white p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-10 rounded-3 p-3 d-flex align-items-center justify-content-center">
                            <i class="bi bi-pencil-square fs-3 text-white"></i>
                        </div>
                        <div>
                            <h1 class="h4 fw-bold mb-1">Edit Product Details</h1>
                            <p class="mb-0 text-white-50 small">Update catalog information and inventory stocks.</p>
                        </div>
                    </div>
                    <span class="badge bg-white bg-opacity-10 text-white border border-white-50 px-3 py-2 rounded-pill font-monospace small">
                        #@Model.Input.ProductId.ToString()[..8]
                    </span>
                </div>
            </div>

            <!-- Form Content -->
            <div class="card-body p-4 p-md-5">
                @if (Model.Error != null)
                {
                    <div class="alert alert-danger shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                        <div>@Model.Error</div>
                    </div>
                }

                <form method="post">
                    <input type="hidden" asp-for="Input.ProductId" />

                    <!-- Product Name -->
                    <div class="mb-4">
                        <label asp-for="Input.Name" class="form-label fw-semibold text-dark">Product Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag"></i></span>
                            <input asp-for="Input.Name" class="form-control bg-light border-start-0 ps-0" placeholder="Product name" />
                        </div>
                        <span asp-validation-for="Input.Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Input.Description" class="form-label fw-semibold text-dark">Description</label>
                        <textarea asp-for="Input.Description" class="form-control bg-light" rows="3" placeholder="Description..."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Price & Stock -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Price" class="form-label fw-semibold text-dark">Price</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-muted">₱</span>
                                <input asp-for="Input.Price" class="form-control bg-light" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Input.Price" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.StockQuantity" class="form-label fw-semibold text-dark">Stock Quantity</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-boxes"></i></span>
                                <input asp-for="Input.StockQuantity" class="form-control bg-light border-start-0 ps-0" type="number" />
                            </div>
                            <span asp-validation-for="Input.StockQuantity" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="Index" class="btn btn-light fw-semibold px-4 rounded-3">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4 rounded-3 shadow-sm">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>