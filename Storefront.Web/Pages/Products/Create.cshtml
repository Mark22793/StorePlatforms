@page
@model Storefront.Web.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Create Product";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <!-- Back Button -->
        <a asp-page="Index" class="btn btn-link text-decoration-none text-muted p-0 mb-3 d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Back to Products
        </a>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <!-- Header Banner -->
            <div class="bg-primary bg-gradient text-white p-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-white bg-opacity-25 rounded-3 p-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-box-seam-fill fs-3 text-white"></i>
                    </div>
                    <div>
                        <h1 class="h4 fw-bold mb-1">Create New Product</h1>
                        <p class="mb-0 text-white-50 small">Add a new item to your storefront catalog database.</p>
                    </div>
                </div>
            </div>

            <!-- Form Content -->
            <div class="card-body p-4 p-md-5">
                <form method="post">
                    <!-- Product Name -->
                    <div class="mb-4">
                        <label asp-for="Input.Name" class="form-label fw-semibold text-dark">Product Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag"></i></span>
                            <input asp-for="Input.Name" class="form-control bg-light border-start-0 ps-0" placeholder="e.g. Wireless Gaming Mouse" />
                        </div>
                        <span asp-validation-for="Input.Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label asp-for="Input.Description" class="form-label fw-semibold text-dark">Description</label>
                        <textarea asp-for="Input.Description" class="form-control bg-light" rows="3" placeholder="Brief product features and specifications..."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Price & Stock -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Price" class="form-label fw-semibold text-dark">Price</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light fw-bold text-muted">₱</span>
                                <input asp-for="Input.Price" class="form-control bg-light" type="number" step="0.01" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Input.Price" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.StockQuantity" class="form-label fw-semibold text-dark">Initial Stock</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-boxes"></i></span>
                                <input asp-for="Input.StockQuantity" class="form-control bg-light border-start-0 ps-0" type="number" placeholder="0" />
                            </div>
                            <span asp-validation-for="Input.StockQuantity" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="Index" class="btn btn-light fw-semibold px-4 rounded-3">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-semibold px-4 rounded-3 shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Save Product
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>